generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int        @id @default(autoincrement())
  nombre      String
  email       String     @unique
  password    String
  activo      Boolean    @default(true)
  rol         String     @default("administrador")
  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Proveedor {
  id                    Int       @id @default(autoincrement())
  codigoProveedor       String?   @unique @db.VarChar(10)
  codigoPais            String?   @db.VarChar(2)
  razonSocial           String
  pais                  String
  ciudad                String
  direccion             String?
  distrito              String?
  codigoPostal          String?
  referencia            String?
  rubro                 String?
  subrubro              String?
  productosComercializa String?   @db.Text
  personaContacto       String?   @db.VarChar(255)
  website               String?   @db.Text
  redesSociales         String?   @db.Text
  comentarios           String?
  entrega               Boolean?  @default(false)
  email                 String?
  ruc                   String?
  licencia              String?
  copiaRucUrl           String?
  copiaLicenciaUrl      String?
  telefono              String?
  whatsapp              String?
  formaPago             String?
  datosPago             String?
  representante         String?
  dni                   String?
  telefonoRep           String?
  copiaDniUrl           String?
  estadoVerificacion    String    @default("NV") @db.VarChar(2)
  fechaVerificacion     DateTime? @db.Timestamptz(3)
  fuenteVerificacion    String?   @db.Text
  fechaDiscovery        DateTime? @db.Date
  evidenciaVerificacion Json?
  activo                Boolean   @default(true)
  usuarioAcceso         String?   @unique
  passwordAcceso        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  pedidos   Pedido[]
  productos ProductoProveedor[]
  rubros    ProveedorRubro[]
  usuarios  User[]
}

model ProveedorRubro {
  id                    Int               @id @default(autoincrement())
  proveedorId           Int
  proveedor             Proveedor         @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  rubro                 String
  subrubro              String            @default("")
  codigoRubro           String?           @db.VarChar(2)
  codigoSubrubro        String?           @db.VarChar(5)
  rubroCatalogo         RubroCatalogo?    @relation(fields: [codigoRubro], references: [codigo], onDelete: Restrict, onUpdate: Cascade)
  subrubroCatalogo      SubrubroCatalogo? @relation(fields: [codigoSubrubro], references: [codigo], onDelete: Restrict, onUpdate: Cascade)
  productosComercializa String?           @db.Text
  fuenteVerificacion    String?           @db.Text
  evidenciaVerificacion Json?
  esPrincipal           Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([proveedorId, rubro, subrubro])
  @@index([proveedorId])
  @@index([rubro])
  @@index([subrubro])
  @@index([rubro, subrubro])
  @@index([codigoRubro])
  @@index([codigoSubrubro])
}

model RubroCatalogo {
  codigo      String             @id @db.VarChar(2)
  nombre      String             @unique @db.VarChar(100)
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  subrubros   SubrubroCatalogo[]
  proveedores ProveedorRubro[]
}

model SubrubroCatalogo {
  codigo      String           @id @db.VarChar(5)
  codigoRubro String           @db.VarChar(2)
  nombre      String           @db.VarChar(150)
  activo      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  rubro       RubroCatalogo    @relation(fields: [codigoRubro], references: [codigo], onDelete: Restrict, onUpdate: Cascade)
  proveedores ProveedorRubro[]

  @@unique([codigoRubro, nombre])
  @@index([codigoRubro])
}

model SecuenciaProveedorPais {
  codigoPais   String   @id @db.VarChar(2)
  ultimoNumero Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductoProveedor {
  id             Int       @id @default(autoincrement())
  proveedorId    Int
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  nombre         String
  descripcion    String?
  precioNacional Float?
  precioDolar    Float?
  moneda         String?
  fotoUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Pedido {
  id             Int          @id @default(autoincrement())
  numero         String       @unique
  proveedorId    Int
  proveedor      Proveedor    @relation(fields: [proveedorId], references: [id])
  fecha          DateTime
  estado         EstadoPedido @default(PENDIENTE)
  comentario     String?
  tipoEntrega    String?
  fechaEntrega   DateTime?
  entregaPuntual Boolean?
  pagoRealizado  Boolean?
  importePagado  Float?
  calidad        Int?
  respuesta      Int?
  puntualidad    Int?
  confianza      Int?
  presentacion   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productos ProductoPedido[]
}

model ProductoPedido {
  id       Int    @id @default(autoincrement())
  pedidoId Int
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  nombre   String
  cantidad Int
  precio   Float
}

enum EstadoPedido {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  AGOTADO
}
